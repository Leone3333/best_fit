<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="/stylesheets/home.css">
    <title>BestFit - Dashboard</title>
</head>

<body>

    <header class="dashboard-header">
        <h1>
            <% if(locals.usuario && usuario.nome) {%>
                <%= usuario.nome %>
                    <% } else {%>
                        Visitante
                        <%}%>
        </h1>
        <span class="material-symbols-outlined" onclick="confirmarSair()">
            exit_to_app
        </span>
    </header>

    <main class="container">
        <section class="welcome-section">
            <h2>Bem vindo!</h2>
        </section>

        <section class="filter-group">
            <form action="/home/filtrar" method="GET" style="display: inline-flex; gap: 10px;">


                <select name="mes" onchange="this.form.submit()">
                    <% const mesesDoAno=dadosFiltro.filter(f=> f.ano === anoSelecionado);

                        if (mesesDoAno.length === 0) {
                        %>
                        <option value="<%= mesSelecionado %>" selected>
                            <%= new Date(0, mesSelecionado - 1).toLocaleString('pt-BR', { month: 'long' }) %>
                        </option>
                        <% } else { mesesDoAno.forEach(item=> {
                            %>
                            <option value="<%= item.mes %>" <%=item.mes===mesSelecionado ? 'selected' : '' %>>
                                <%= new Date(0, item.mes - 1).toLocaleString('pt-BR', { month: 'long' }) %>
                            </option>
                            <% }); } %>

                </select>

                <select name="ano" onchange="this.form.submit()">
                    <% const anosUnicos=[...new Set(dadosFiltro.map(f=> f.ano))];

                        if (anosUnicos.length === 0) {
                        %>
                        <option value="<%= anoSelecionado %>" selected>
                            <%= anoSelecionado %>
                        </option>
                        <% } else { anosUnicos.forEach(ano=> {
                            %>
                            <option value="<%= ano %>" <%=ano===anoSelecionado ? 'selected' : '' %>>
                                <%= ano %>
                            </option>
                            <% }); } %>

                </select>

            </form>
        </section>
        <section class="toneladas-card">
            <% if (tonelagem>= 1000) { %>
                <h3>
                    <%= Math.floor(tonelagem / 1000) %> toneladas
                        <% if (tonelagem % 1000> 0) { %>
                            e <%= tonelagem % 1000 %> Kg
                                <% } %>
                                    em <%= new Date(0, mesSelecionado - 1).toLocaleString('pt-BR', { month: 'long' }) %>
                                        de <%= anoSelecionado %>!!
                </h3>
                <% } else { %>
                    <h3>
                        <%= tonelagem || 0 %> Kg em <%= new Date(0, mesSelecionado - 1).toLocaleString('pt-BR', {
                                month: 'long' }) %> de <%= anoSelecionado %>!!
                    </h3>
                    <% } %>
        </section>
        <div class="dashboard-row" style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 20px;">

            <div class="chart-card" style="flex: 1; min-width: 300px; max-width: 450px;">
                <h3>Uso de Fichas no Mês</h3>
                <canvas id="graficoFichasPizza"></canvas>
            </div>

            <div class="chart-card" style="flex: 1; min-width: 300px;">
                <h3>Top 5 Melhores Exercícios</h3>
                <canvas id="graficoTreinosBarras"></canvas>
            </div>

        </div>
    </main>

    <nav class="bottom-nav">
        <div class="nav-wrapper">

            <a style="text-decoration: none; color:inherit" href="/fichas">
                <div class="icon-label">
                    <span class="material-symbols-outlined" style="color:#fff">exercise</span>
                    <p>Treinos</p>
            </a>
        </div>

        </div>
    </nav>

</body>
<script src="/javascripts/logout.js"></script>
<script>
    // 1. CAPTURA DOS DADOS VINDOS DO EXPRESS/EJS
    window.dadosFichaServer = <%- JSON.stringify(dadosFicha || []) %>;
    window.dadosTreinosServer = <%- JSON.stringify(dadosTreinos || []) %>;


    // 2. CONFIGURAÇÃO DO GRÁFICO DE PIZZA (Frequência de Fichas)
    window.labelsFichas = window.dadosFichaServer.map(item => `Ficha ${item.divisao}`);
    window.valoresFichas = window.dadosFichaServer.map(item => parseInt(item.sessoes_realizadas) || 0);

    const top5Treinos = window.dadosTreinosServer.slice(0, 5);

    // Uso do ?. evita erros caso a propriedade venha nula do banco
    window.labelsExercicios = top5Treinos.map(item => item?.exercicio || 'Inominado');
    window.valoresExercicios = top5Treinos.map(item => parseInt(item?.maior_carga) || 0);
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/javascripts/graficos.js"></script>

</html>