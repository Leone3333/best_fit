<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="/stylesheets/home.css">

    <title>BestFit - Dashboard</title>
</head>

<body>

    <header class="dashboard-header">
        <h1>
            <% if(locals.usuario && usuario.nome) {%>
                <%= usuario.nome %>
                    <% } else {%>
                        Visitante
                        <%}%>
        </h1>
        <span class="material-symbols-outlined" onclick="confirmarSair()">
            exit_to_app
        </span>
    </header>

    <main class="container">
        <section class="welcome-section">
            <h2>Bem vindo!</h2>
        </section>

        <section class="filter-group">
            <form action="/home/filtrar" method="GET" style="display: inline-flex; gap: 10px;">


                <select name="mes" onchange="this.form.submit()">
                    <% const mesesDoAno=dadosFiltro.filter(f=> f.ano === anoSelecionado);

                        if (mesesDoAno.length === 0) {
                        %>
                        <option value="<%= mesSelecionado %>" selected>
                            <%= new Date(0, mesSelecionado - 1).toLocaleString('pt-BR', { month: 'long' }) %>
                        </option>
                        <% } else { mesesDoAno.forEach(item=> {
                            %>
                            <option value="<%= item.mes %>" <%=item.mes===mesSelecionado ? 'selected' : '' %>>
                                <%= new Date(0, item.mes - 1).toLocaleString('pt-BR', { month: 'long' }) %>
                            </option>
                            <% }); } %>

                </select>

                <select name="ano" onchange="this.form.submit()">
                    <% const anosUnicos=[...new Set(dadosFiltro.map(f=> f.ano))];

                        if (anosUnicos.length === 0) {
                        %>
                        <option value="<%= anoSelecionado %>" selected>
                            <%= anoSelecionado %>
                        </option>
                        <% } else { anosUnicos.forEach(ano=> {
                            %>
                            <option value="<%= ano %>" <%=ano===anoSelecionado ? 'selected' : '' %>>
                                <%= ano %>
                            </option>
                            <% }); } %>

                </select>

            </form>
        </section>
        <section class="toneladas-card">
            <h3>X Toneladas em setembro!!</h3>
        </section>

        <section class="charts-container">
            <div id="chart-pizza" class="pizza-chart-placeholder">
            </div>

            <div id="chart-lines" class="lines-chart-placeholder">
                <div class="bar-line" style="width: 100%;"></div>
                <div class="bar-line" style="width: 80%;"></div>
                <div class="bar-line" style="width: 45%;"></div>
            </div>
        </section>
    </main>

    <nav class="bottom-nav">
        <div class="nav-wrapper">

            <a style="text-decoration: none; color:inherit" href="/fichas">
                <div class="icon-label">
                    <span class="material-symbols-outlined" style="color:#fff">exercise</span>
                    <p>Treinos</p>
            </a>
        </div>

        </div>
    </nav>

</body>
<script src="/javascripts/logout.js"></script>

</html>