<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="/stylesheets/visualizarTreino.css">
    <title>BestFit - Treino Selecionado</title>
</head>

<body>

    <header>
        <h1>
            <%=treinoSelecionado.exercicio.exercicio_nome%>
        </h1>
    </header>

    <main style="width: 100%; display: flex; flex-direction: column; align-items: center; flex: 1;">

        <div id="exercise-image" class="exercise-image-container">
            <img src="/images/<%=treinoSelecionado.exercicio.imagem_exercicio%>">
        </div>

        <section class="controls-section">

            <div class="control-item">
                <span class="control-label">Series realziadas</span>
                <div class="control-data">
                    <button class="btn-adjust">-</button>
                    <span id="serie-value">
                        <%=treinoSelecionado.serie%>
                    </span>
                    <button class="btn-adjust">+</button>
                </div>
            </div>

            <div class="control-item">
                <span class="control-label">Repetições realizadas </span>
                <div class="control-data">
                    <div class="rep-selector">
                        <input type="number" class="input-underline" placeholder="<%=treinoSelecionado.repeticoes%>">
                    </div>
                </div>
            </div>

            <div class="control-item">
                <span class="control-label">Carga realizada</span>
                <div class="control-data">
                    <input type="number" class="input-underline" placeholder="<%=treinoSelecionado.carga%>">
                </div>
            </div>

        </section>

        <section class="actions-section">
            <button class="btn-action btn-cancel">Cancelar</button>
            <button class="btn-action btn-finish">Finalizar</button>
        </section>

    </main>

    <nav class="bottom-nav">
        <div class="nav-circle-item" style="width: 45px; height: 45px; position: absolute; left: 20px;">
            <div class="icon-label">

                <button onclick="history.back()"
                    style="background: none; border: none; color: inherit; cursor: pointer; padding: 0;">
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
            </div>
        </div>


        <a href="/home" style="text-decoration: none; color: inherit;">
            <div class="icon-label">
                <span style="color:aliceblue" class="material-symbols-outlined">home</span>
                <p>Home</p>
            </div>
        </a>
    </nav>

</body>

</html>